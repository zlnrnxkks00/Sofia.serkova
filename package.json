{
  "name": "sofia-serkova",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sofia Serkova prerendered React website",
  "engines": { "node": "^24.15.0" },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check.mjs",
    "test:legacy": "node scripts/test.mjs",
    "test:react": "node scripts/test-react.mjs",
    "test": "npm run test:legacy && npm run build:react && npm run test:react",
    "build:legacy": "node scripts/build.mjs",
    "build:react": "node scripts/build-react.mjs",
    "build": "npm run check && npm test"
  },
  "dependencies": {
    "lucide-react": "1.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "fontkit": "2.0.4",
    "html-validate": "11.17.0",
    "jsdom": "30.1.3",
    "parse5": "8.0.1",
    "postcss": "8.5.31",
    "postcss-value-parser": "4.2.0",
    "sass": "1.106.0",
    "sharp": "0.35.5",
    "vite": "8.3.5"
  }
}
